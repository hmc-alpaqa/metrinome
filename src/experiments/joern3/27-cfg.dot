digraph "decimalToBinary" {  
"990" [label = <(&lt;operator&gt;.assignment,binary = 0)<SUB>5</SUB>> ]
"994" [label = <(&lt;operator&gt;.assignment,base = 1)<SUB>6</SUB>> ]
"1021" [label = <(RETURN,return binary;,return binary;)<SUB>15</SUB>> ]
"998" [label = <(&lt;operator&gt;.greaterThan,decimal &gt; 0)<SUB>8</SUB>> ]
"1003" [label = <(&lt;operator&gt;.assignment,remainder = decimal % 2)<SUB>9</SUB>> ]
"1008" [label = <(&lt;operator&gt;.assignment,decimal = decimal / 2)<SUB>10</SUB>> ]
"1013" [label = <(&lt;operator&gt;.assignmentPlus,binary += remainder * base)<SUB>11</SUB>> ]
"1018" [label = <(&lt;operator&gt;.assignmentMultiplication,base *= 10)<SUB>12</SUB>> ]
"1005" [label = <(&lt;operator&gt;.modulo,decimal % 2)<SUB>9</SUB>> ]
"1010" [label = <(&lt;operator&gt;.division,decimal / 2)<SUB>10</SUB>> ]
"1015" [label = <(&lt;operator&gt;.multiplication,remainder * base)<SUB>11</SUB>> ]
"986" [label = <(METHOD,decimalToBinary)<SUB>4</SUB>> ]
"1023" [label = <(METHOD_RETURN,long)<SUB>4</SUB>> ]
  "990" -> "994" 
  "994" -> "998" 
  "1021" -> "1023" 
  "998" -> "1005" 
  "998" -> "1021" 
  "1003" -> "1010" 
  "1008" -> "1015" 
  "1013" -> "1018" 
  "1018" -> "998" 
